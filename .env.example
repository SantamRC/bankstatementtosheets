# ─── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Public URL (used for OAuth redirects & Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to encrypt Google tokens in cookies. Generate: openssl rand -base64 32
APP_SECRET=

# ─── Extraction tuning (optional) ─────────────────────────
# EXTRACTION_MODE=cascade            # cascade (fast model, escalate failures) | single (strong model only)
# EXTRACTION_MODEL_FAST=claude-haiku-5-5
# EXTRACTION_MODEL_STRONG=claude-opus-5-5
# EXTRACTION_EFFORT=medium          # low | medium | high
# EXTRACTION_PAGES_PER_CHUNK=5
# EXTRACTION_CONCURRENCY=4
# MAX_PAGES_PER_FILE=150

# ─── Supabase (auth, credits, history). Leave blank to run in local dev mode without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PACK_100=

# ─── Google Sheets export (OAuth client, scope drive.file) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
