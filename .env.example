# ─── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Public URL (used for OAuth redirects & Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to encrypt Google tokens in cookies. Generate: openssl rand -base64 32
APP_SECRET=

# ─── Extraction tuning (optional) ─────────────────────────
# EXTRACTION_MODE=cascade            # cascade (fast model, escalate failures) | single (strong model only)
# EXTRACTION_MODEL_FAST=claude-haiku-5-5
# EXTRACTION_MODEL_STRONG=claude-opus-5-5
# EXTRACTION_EFFORT=medium          # low | medium | high
# EXTRACTION_PAGES_PER_CHUNK=5
# EXTRACTION_CONCURRENCY=4
# MAX_PAGES_PER_FILE=150

# ─── Supabase (auth, credits, history). Leave blank to run in local dev mode without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" on /login (set to 1 after enabling the Google provider in Supabase Auth)
NEXT_PUBLIC_AUTH_GOOGLE=
SUPABASE_SECRET_KEY=

# ─── Transactional email (Brevo API; our own welcome/pack emails — Dodo still sends receipts) ───
# Brevo → SMTP & API → API keys. Leave blank to skip our emails. Sender domain is authenticated in Brevo.
BREVO_API_KEY=
EMAIL_FROM=no-reply@bankstatementtosheets.com

# ─── Dodo Payments (merchant of record) ───────────────────
# Dashboard → Developer → API keys / Webhooks. Use test_mode keys + test product IDs locally.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# One tax-inclusive product per plan × interval × currency — created by `npm run dodo:setup`
DODO_PRODUCT_STARTER_MONTHLY_USD=
DODO_PRODUCT_STARTER_YEARLY_USD=
DODO_PRODUCT_PRO_MONTHLY_USD=
DODO_PRODUCT_PRO_YEARLY_USD=
DODO_PRODUCT_BUSINESS_MONTHLY_USD=
DODO_PRODUCT_BUSINESS_YEARLY_USD=
DODO_PRODUCT_STARTER_MONTHLY_EUR=
DODO_PRODUCT_STARTER_YEARLY_EUR=
DODO_PRODUCT_PRO_MONTHLY_EUR=
DODO_PRODUCT_PRO_YEARLY_EUR=
DODO_PRODUCT_BUSINESS_MONTHLY_EUR=
DODO_PRODUCT_BUSINESS_YEARLY_EUR=
DODO_PRODUCT_STARTER_MONTHLY_INR=
DODO_PRODUCT_STARTER_YEARLY_INR=
DODO_PRODUCT_PRO_MONTHLY_INR=
DODO_PRODUCT_PRO_YEARLY_INR=
DODO_PRODUCT_BUSINESS_MONTHLY_INR=
DODO_PRODUCT_BUSINESS_YEARLY_INR=
DODO_PRODUCT_PACK_100_USD=
DODO_PRODUCT_PACK_100_EUR=
DODO_PRODUCT_PACK_100_INR=

# ─── Google Sheets export (OAuth client, scope drive.file) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
